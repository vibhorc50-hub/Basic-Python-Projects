import random

board = [' '] * 10  # index 0 unused, 1-9 are the squares

LINES = [
    (1, 2, 3), (4, 5, 6), (7, 8, 9),  # rows
    (1, 4, 7), (2, 5, 8), (3, 6, 9),  # columns
    (1, 5, 9), (3, 5, 7)              # diagonals
]


def display_board(board):
    print()
    print(board[1], '|', board[2], '|', board[3])
    print('---------')
    print(board[4], '|', board[5], '|', board[6])
    print('---------')
    print(board[7], '|', board[8], '|', board[9])
    print()


def enter_move(board, sign):
    while True:
        move = input(f"Player '{sign}', enter your move (1-9): ")
        if not move.isdigit():
            print("Please enter a valid number.")
            continue
        move = int(move)
        if move < 1 or move > 9:
            print("The number must be between 1 and 9.")
            continue
        if board[move] != ' ':
            print("This square is already occupied. Choose another one.")
            continue
        board[move] = sign
        return


def make_list_of_free_fields(board):
    return [i for i in range(1, 10) if board[i] == ' ']


def victory_for(board, sign):
    for a, b, c in LINES:
        if board[a] == board[b] == board[c] == sign:
            return True
    return False


def game_status(board, sign_a, sign_b):
    if victory_for(board, sign_a):
        return sign_a
    if victory_for(board, sign_b):
        return sign_b
    if not make_list_of_free_fields(board):
        return 'TIE'
    return 'CONTINUE'


def announce_result(status, mode):
    if status == 'TIE':
        print("It's a tie!")
    elif mode == 'ai':
        if status == 'X':
            print("The computer wins! Better luck next time.")
        else:
            print("Congratulations, you win!")
    else:
        print(f"Player '{status}' wins!")


# ---------- AI move strategies ----------

def find_winning_move(board, sign):
    """Return a square that would let `sign` win immediately, or None."""
    for square in make_list_of_free_fields(board):
        board[square] = sign
        won = victory_for(board, sign)
        board[square] = ' '
        if won:
            return square
    return None


def random_move(board):
    return random.choice(make_list_of_free_fields(board))


def easy_move(board, ai_sign, human_sign):
    # Fully random - no strategy at all
    return random_move(board)


def medium_move(board, ai_sign, human_sign):
    # 1) Win if possible
    move = find_winning_move(board, ai_sign)
    if move:
        return move
    # 2) Block the opponent if they'd win next turn
    move = find_winning_move(board, human_sign)
    if move:
        return move
    # 3) Otherwise, random
    return random_move(board)


def minimax(board, sign, ai_sign, human_sign):
    status = game_status(board, ai_sign, human_sign)
    if status == ai_sign:
        return 1, None
    elif status == human_sign:
        return -1, None
    elif status == 'TIE':
        return 0, None

    free_fields = make_list_of_free_fields(board)
    best_move = None

    if sign == ai_sign:
        best_score = -2
        for square in free_fields:
            board[square] = sign
            score, _ = minimax(board, human_sign, ai_sign, human_sign)
            board[square] = ' '
            if score > best_score:
                best_score = score
                best_move = square
    else:
        best_score = 2
        for square in free_fields:
            board[square] = sign
            score, _ = minimax(board, ai_sign, ai_sign, human_sign)
            board[square] = ' '
            if score < best_score:
                best_score = score
                best_move = square

    return best_score, best_move


def hard_move(board, ai_sign, human_sign):
    # Unbeatable: full minimax search
    _, move = minimax(board, ai_sign, ai_sign, human_sign)
    return move


DIFFICULTY_FUNCS = {
    '1': easy_move,
    '2': medium_move,
    '3': hard_move,
}


def choose_difficulty():
    while True:
        print("Choose a difficulty level:")
        print("1 - Easy (random moves)")
        print("2 - Medium (blocks/wins when it can, random otherwise)")
        print("3 - Hard (unbeatable)")
        choice = input("Enter 1, 2 or 3: ")
        if choice in DIFFICULTY_FUNCS:
            return DIFFICULTY_FUNCS[choice]
        print("Invalid choice, please try again.\n")


# ---------- Game modes ----------

def play_vs_ai():
    global board
    board = [' '] * 10
    ai_move = choose_difficulty()

    print("\nYou play 'O', the computer plays 'X'. The computer goes first.")

    # Computer's first move is always the middle square
    board[5] = 'X'
    display_board(board)

    while True:
        status = game_status(board, 'X', 'O')
        if status != 'CONTINUE':
            announce_result(status, 'ai')
            break

        enter_move(board, 'O')
        display_board(board)

        status = game_status(board, 'X', 'O')
        if status != 'CONTINUE':
            announce_result(status, 'ai')
            break

        print("Computer is making its move...")
        square = ai_move(board, 'X', 'O')
        board[square] = 'X'
        display_board(board)


def play_two_players():
    global board
    board = [' '] * 10
    print("\nPlayer 1 is 'X', Player 2 is 'O'. Player 1 goes first.")
    display_board(board)

    current_sign = 'X'
    while True:
        enter_move(board, current_sign)
        display_board(board)

        status = game_status(board, 'X', 'O')
        if status != 'CONTINUE':
            announce_result(status, 'pvp')
            break

        current_sign = 'O' if current_sign == 'X' else 'X'


def choose_mode():
    while True:
        print("Choose a game mode:")
        print("1 - Player vs Computer")
        print("2 - Player vs Player")
        choice = input("Enter 1 or 2: ")
        if choice == '1':
            return 'ai'
        elif choice == '2':
            return 'pvp'
        else:
            print("Invalid choice, please try again.\n")


def main():
    print("Welcome to Tic-Tac-Toe!")
    print("Squares are numbered 1-9, row by row, like this:")
    print("1 | 2 | 3")
    print("4 | 5 | 6")
    print("7 | 8 | 9")
    print()

    while True:
        mode = choose_mode()
        if mode == 'ai':
            play_vs_ai()
        else:
            play_two_players()

        again = input("\nPlay again? (y/n): ").strip().lower()
        if again != 'y':
            print("Thanks for playing!")
            break
        print()


if __name__ == "__main__":
    main()